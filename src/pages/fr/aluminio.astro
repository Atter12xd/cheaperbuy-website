---
import MainLayout from "@/layouts/MainLayout.astro";

// Datos para avatars
const avatarSrcs = [
  "/images/p1-1.jpeg",
  "/images/p2-1.jpeg",
  "/images/p3.jpeg",
  "/images/p4.jpeg"
];
---

<MainLayout
  title="Puertas de Aluminio Premium | ARCHIPIER BUILDER SUPPLY"
  lang="es"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": "https://archiperbuilder.com/aluminio",
    url: "https://archiperbuilder.com/aluminio",
    name: "Puertas y Ventanas de Aluminio Premium",
    description: "Descubre nuestra colección completa de puertas y ventanas de aluminio de alta calidad con diseño moderno, garantía de 10 años y instalación profesional incluida.",
    brand: {
      "@type": "Brand",
      name: "ARCHIPIER BUILDER SUPPLY"
    },
    inLanguage: "es",
  }}
>

<!-- Hero Principal -->
<section class="relative py-20 bg-gradient-to-br from-primary-50 via-white to-primary-50 dark:from-primary-900 dark:via-primary-800 dark:to-primary-900 overflow-hidden">
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width=%2260%22%20height=%2260%22%20viewBox=%220%200%2060%2060%22%20xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg%20fill=%22none%22%20fill-rule=%22evenodd%22%3E%3Cg%20fill=%22%23A0522D%22%20fill-opacity=%220.05%22%3E%3Cpath%20d=%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-30"></div>
  
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-20">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-primary-800 dark:text-primary-100 mb-8">
        <span class="block">Puertas y Ventanas de</span>
        <span class="block bg-gradient-to-r from-wood-600 via-wood-700 to-wood-800 bg-clip-text text-transparent">Aluminio Premium</span>
      </h1>
      <p class="mx-auto max-w-4xl text-xl md:text-2xl text-primary-600 dark:text-primary-300 leading-relaxed mb-12">
        Transforma tus espacios con nuestras puertas y ventanas de aluminio de última generación. Diseño, seguridad y durabilidad en perfecta armonía con garantía de 10 años.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="#productos" class="group inline-flex items-center justify-center px-10 py-5 text-lg font-semibold text-white bg-gradient-to-r from-primary-800 to-primary-900 rounded-xl hover:from-primary-900 hover:to-black transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
          Explorar Nuestros Productos
          <svg class="w-6 h-6 ml-3 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href="https://wa.me/51933484150?text=Hola%2C%20me%20interesa%20información%20sobre%20sus%20productos%20de%20aluminio." target="_blank" class="inline-flex items-center justify-center px-10 py-5 text-lg font-semibold text-primary-800 dark:text-primary-200 bg-white dark:bg-primary-800 border-2 border-primary-300 dark:border-primary-600 rounded-xl hover:bg-primary-50 dark:hover:bg-primary-700 transition-all duration-300 shadow-xl">
          Solicitar Cotización
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Presentación Visual - Imagen Destacada -->
<section class="py-8 bg-white dark:bg-primary-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="group cursor-pointer">
      <div class="rounded-2xl overflow-hidden shadow-2xl hover:shadow-3xl transition-all duration-500 transform hover:scale-[1.02]">
        <img
          src="/images/DISEÑO.jpg"
          alt="Archipier Builder Supply - Premium Aluminum Solutions"
class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-700"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<!-- Presentación de Aluminio -->
<section class="py-16 bg-gradient-to-br from-primary-50 via-white to-primary-50 dark:from-primary-900 dark:via-primary-800 dark:to-primary-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-primary-800 dark:text-primary-100 mb-6">
        {Astro.currentLocale === "en" ? "Why Choose Aluminum?" : "¿Por Qué Elegir Aluminio?"}
      </h2>
      <p class="text-xl text-primary-600 dark:text-primary-300 max-w-4xl mx-auto leading-relaxed">
        {Astro.currentLocale === "en" 
          ? "Aluminum is the perfect choice for modern construction. Lightweight, durable, and sustainable, our premium aluminum products combine cutting-edge technology with elegant design." 
          : "El aluminio es la elección perfecta para la construcción moderna. Liviano, duradero y sostenible, nuestros productos de aluminio premium combinan tecnología de vanguardia con diseño elegante."}
      </p>
    </div>

    <!-- Ventajas del Aluminio -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      <div class="text-center group">
        <div class="mx-auto w-20 h-20 bg-gradient-to-br from-wood-600 to-wood-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-3">
          {Astro.currentLocale === "en" ? "Lightweight & Strong" : "Liviano y Resistente"}
        </h3>
        <p class="text-primary-600 dark:text-primary-300">
          {Astro.currentLocale === "en" 
            ? "3x lighter than steel but equally strong and durable" 
            : "3 veces más liviano que el acero pero igualmente fuerte y duradero"}
        </p>
      </div>

      <div class="text-center group">
        <div class="mx-auto w-20 h-20 bg-gradient-to-br from-green-600 to-green-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-3">
          {Astro.currentLocale === "en" ? "Eco-Friendly" : "Eco-Amigable"}
        </h3>
        <p class="text-primary-600 dark:text-primary-300">
          {Astro.currentLocale === "en" 
            ? "100% recyclable material with minimal environmental impact" 
            : "Material 100% reciclable con mínimo impacto ambiental"}
        </p>
      </div>

      <div class="text-center group">
        <div class="mx-auto w-20 h-20 bg-gradient-to-br from-blue-600 to-blue-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-3">
          {Astro.currentLocale === "en" ? "Corrosion Resistant" : "Resistente a la Corrosión"}
        </h3>
        <p class="text-primary-600 dark:text-primary-300">
          {Astro.currentLocale === "en" 
            ? "Natural oxide layer protects against rust and weather" 
            : "Capa de óxido natural protege contra óxido y clima"}
        </p>
      </div>

      <div class="text-center group">
        <div class="mx-auto w-20 h-20 bg-gradient-to-br from-purple-600 to-purple-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-3">
          {Astro.currentLocale === "en" ? "Low Maintenance" : "Bajo Mantenimiento"}
        </h3>
        <p class="text-primary-600 dark:text-primary-300">
          {Astro.currentLocale === "en" 
            ? "No painting or special treatments needed, just simple cleaning" 
            : "No necesita pintura o tratamientos especiales, solo limpieza simple"}
        </p>
      </div>
    </div>

    <!-- Estadísticas -->
    <div class="bg-gradient-to-r from-primary-800 to-primary-900 dark:from-primary-700 dark:to-primary-800 rounded-2xl p-8 text-white">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-wood-400 mb-2">25+</div>
          <div class="text-primary-200">
            {Astro.currentLocale === "en" ? "Years Durability" : "Años de Durabilidad"}
          </div>
        </div>
        <div>
          <div class="text-4xl font-bold text-wood-400 mb-2">100%</div>
          <div class="text-primary-200">
            {Astro.currentLocale === "en" ? "Recyclable" : "Reciclable"}
          </div>
        </div>
        <div>
          <div class="text-4xl font-bold text-wood-400 mb-2">350+</div>
          <div class="text-primary-200">
            {Astro.currentLocale === "en" ? "Happy Clients" : "Clientes Satisfechos"}
          </div>
        </div>
        <div>
          <div class="text-4xl font-bold text-wood-400 mb-2">10</div>
          <div class="text-primary-200">
            {Astro.currentLocale === "en" ? "Year Warranty" : "Años Garantía"}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Catálogo de Productos -->
<section id="productos" class="py-20 bg-white dark:bg-primary-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-primary-800 dark:text-primary-100 mb-6">
        {Astro.currentLocale === "en" ? "Our Aluminum Products" : "Nuestros Productos de Aluminio"}
      </h2>
      <p class="text-xl text-primary-600 dark:text-primary-300 max-w-3xl mx-auto">
        {Astro.currentLocale === "en" 
          ? "Discover our complete range of premium aluminum doors and windows, each designed with precision and built to last" 
          : "Descubre nuestra gama completa de puertas y ventanas de aluminio premium, cada una diseñada con precisión y construida para durar"}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Producto 1 -->
      <a href="/fr/puerta-elite-moderna" class="group bg-white dark:bg-primary-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden border border-primary-200 dark:border-primary-700 transform hover:scale-105">
        <div class="aspect-square overflow-hidden relative">
          <img
            src="/images/p1-1.jpeg"
            alt="Puerta Elite Moderna"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-green-600 text-white text-xs font-bold px-3 py-1 rounded-full">NUEVO</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-2 group-hover:text-wood-600 dark:group-hover:text-wood-400 transition-colors">
            {Astro.currentLocale === "en" ? "Elite Modern Door" : "Puerta Elite Moderna"}
          </h3>
          <p class="text-primary-600 dark:text-primary-300 text-sm mb-4 leading-relaxed">
            {Astro.currentLocale === "en" 
              ? "High-resistance aluminum door with premium finish and advanced security system" 
              : "Puerta de aluminio de alta resistencia con acabado premium y sistema de seguridad avanzado"}
          </p>
          <div class="flex items-center justify-between">
            <span class="text-2xl font-bold text-wood-600 dark:text-wood-400">S/. 2,850</span>
            <span class="bg-primary-600 text-white px-4 py-2 rounded-lg text-sm font-medium group-hover:bg-primary-700 transition-colors">
              {Astro.currentLocale === "en" ? "View Details" : "Ver Detalles"}
            </span>
          </div>
        </div>
      </a>

      <!-- Producto 2 -->
      <a href="/fr/puerta-corrediza-cristal" class="group bg-white dark:bg-primary-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden border border-primary-200 dark:border-primary-700 transform hover:scale-105">
        <div class="aspect-square overflow-hidden relative">
          <img
            src="/images/p1-2.jpeg"
            alt="Puerta Corrediza Cristal"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-yellow-600 text-white text-xs font-bold px-3 py-1 rounded-full">DESTACADO</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-2 group-hover:text-wood-600 dark:group-hover:text-wood-400 transition-colors">
            {Astro.currentLocale === "en" ? "Glass Sliding Door" : "Puerta Corrediza Cristal"}
          </h3>
          <p class="text-primary-600 dark:text-primary-300 text-sm mb-4 leading-relaxed">
            {Astro.currentLocale === "en" 
              ? "Panoramic sliding door with laminated and tempered glass, premium sliding system" 
              : "Puerta corrediza panorámica con vidrio laminado y templado, sistema deslizable premium"}
          </p>
          <div class="flex items-center justify-between">
            <span class="text-2xl font-bold text-wood-600 dark:text-wood-400">S/. 3,200</span>
            <span class="bg-primary-600 text-white px-4 py-2 rounded-lg text-sm font-medium group-hover:bg-primary-700 transition-colors">
              {Astro.currentLocale === "en" ? "View Details" : "Ver Detalles"}
            </span>
          </div>
        </div>
      </a>

      <!-- Producto 3 -->
      <a href="/fr/puerta-batiente-premium" class="group bg-white dark:bg-primary-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden border border-primary-200 dark:border-primary-700 transform hover:scale-105">
        <div class="aspect-square overflow-hidden">
          <img
            src="/images/p3.jpeg"
            alt="Puerta Batiente Premium"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-2 group-hover:text-wood-600 dark:group-hover:text-wood-400 transition-colors">
            {Astro.currentLocale === "en" ? "Premium Swing Door" : "Puerta Batiente Premium"}
          </h3>
          <p class="text-primary-600 dark:text-primary-300 text-sm mb-4 leading-relaxed">
            {Astro.currentLocale === "en" 
              ? "Contemporary design with excellent thermal insulation and energy efficiency" 
              : "Diseño contemporáneo con excelente aislamiento térmico y eficiencia energética"}
          </p>
          <div class="flex items-center justify-between">
            <span class="text-2xl font-bold text-wood-600 dark:text-wood-400">S/. 2,650</span>
            <span class="bg-primary-600 text-white px-4 py-2 rounded-lg text-sm font-medium group-hover:bg-primary-700 transition-colors">
              {Astro.currentLocale === "en" ? "View Details" : "Ver Detalles"}
            </span>
          </div>
        </div>
      </a>

      <!-- Producto 4 -->
      <a href="/fr/sistema-comercial" class="group bg-white dark:bg-primary-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden border border-primary-200 dark:border-primary-700 transform hover:scale-105">
        <div class="aspect-square overflow-hidden">
          <img
            src="/images/p4.jpeg"
            alt="Sistema Comercial"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-2 group-hover:text-wood-600 dark:group-hover:text-wood-400 transition-colors">
            {Astro.currentLocale === "en" ? "Commercial System" : "Sistema Comercial"}
