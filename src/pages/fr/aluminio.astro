          <p class="text-primary-600 dark:text-primary-300 text-sm mb-4 leading-relaxed">
            {Astro.currentLocale === "en" 
              ? "Large panoramic window with aluminum frame for maximum natural light" 
              : "Ventana panorámica amplia con marco de aluminio para máxima luz natural"}
          </p>
          <div class="flex items-center justify-between">
            <span class="text-2xl font-bold text-wood-600 dark:text-wood-400">S/. 1,850</span>
            <span class="bg-primary-600 text-white px-4 py-2 rounded-lg text-sm font-medium group-hover:bg-primary-700 transition-colors">
              {Astro.currentLocale === "en" ? "View Details" : "Ver Detalles"}
            </span>
          </div>
        </div>
      </a>

      <!-- Producto 6 -->
      <a href="/fr/puerta-doble-hoja" class="group bg-white dark:bg-primary-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden border border-primary-200 dark:border-primary-700 transform hover:scale-105">
        <div class="aspect-square overflow-hidden">
          <img
            src="/images/p6.jpeg"
            alt="Puerta Doble Hoja"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary-800 dark:text-primary-100 mb-2 group-hover:text-wood-600 dark:group-hover:text-wood-400 transition-colors">
            {Astro.currentLocale === "en" ? "Double Leaf Door" : "Puerta Doble Hoja"}
          </h3>
          <p class="text-primary-600 dark:text-primary-300 text-sm mb-4 leading-relaxed">
