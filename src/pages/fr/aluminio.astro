          if (modal) {
        modal.classList.remove('opacity-0', 'invisible');
        const bgWhite = modal.querySelector('.bg-white') as HTMLElement | null;
        if (bgWhite) {
          bgWhite.classList.remove('scale-95');
          bgWhite.classList.add('scale-100');
        }
      }
      
      const closeButton = document.getElementById('close-modal');
      if (closeButton) {
        closeButton.addEventListener('click', closeModal);
      }
    }
