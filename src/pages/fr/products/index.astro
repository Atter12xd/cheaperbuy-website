---
import MainLayout from "@/layouts/MainLayout.astro";
import ProductCard from "@components/ui/cards/ProductCard.astro";
import { SITE } from "@data/constants";
import { getProductsByCategory } from "@data/products";

const title = "Productos";
const subTitle =
  "En ARCHIPIER BUILDER SUPPLY ofrecemos materiales premium: aluminio, madera y metal. Haz clic en un producto para ver precios, beneficios y detalles.";

const aluminioProducts = getProductsByCategory("aluminum");
const maderaProducts = getProductsByCategory("wood");
const metalProducts = getProductsByCategory("metal");

const pageTitle = `Productos | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  lang="es"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/fr/products`,
    url: `${SITE.url}/fr/products`,
    name: `Productos | ${SITE.title}`,
    description: "Materiales de construcción premium: aluminio, madera y metal. ARCHIPIER BUILDER SUPPLY.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: "es",
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-8 md:mb-12">
      <h1
        class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
      >
        {title}
      </h1>
      {
        subTitle && (
          <p class="mt-2 max-w-screen-sm text-pretty text-neutral-600 dark:text-neutral-400 md:block">
            {subTitle}
          </p>
        )
      }
    </div>

    <section id="aluminio" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Aluminio
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Puertas y ventanas de aluminio premium. Haz clic en un producto para ver precios, beneficios y detalles.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          aluminioProducts.map((product) => (
            <ProductCard product={product} locale="fr" />
          ))
        }
      </div>
    </section>

    <section id="madera" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Madera
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Productos de madera premium. Haz clic en un producto para ver precios, beneficios y detalles.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          maderaProducts.map((product) => (
            <ProductCard product={product} locale="fr" />
          ))
        }
      </div>
    </section>

    <section id="metal" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Metal
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Puertas y herrajes de metal premium. Haz clic en un producto para ver precios, beneficios y detalles.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          metalProducts.map((product) => (
            <ProductCard product={product} locale="fr" />
          ))
        }
      </div>
    </section>
  </div>
</MainLayout>
