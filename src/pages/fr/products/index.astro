---
import MainLayout from "@/layouts/MainLayout.astro";
import CardSmall from "@components/ui/cards/CardSmall.astro";
import CardWide from "@components/ui/cards/CardWide.astro";
import { SITE } from "@data/constants";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Spanish: content id starts with "fr/"
const allProducts: CollectionEntry<"products">[] = (
  await getCollection("products", ({ id }) => id.startsWith("fr/"))
).sort(
  (a: CollectionEntry<"products">, b: CollectionEntry<"products">) =>
    a.data.main.id - b.data.main.id
);

// Exclude Almendro and Ana Caspi (item-t845, item-a765)
const excludeIds = ["fr/item-t845", "fr/item-a765"];
const productsMadera = allProducts.filter((p) => !excludeIds.includes(p.id));

// Imágenes de public/images — enfoque en aluminio y metal
const aluminioImages = ["/images/p13.jpeg", "/images/p14.jpeg", "/images/p20.jpeg", "/images/fo-ro2.jpeg", "/images/fo-ro1.jpeg"];
const metalImages = ["/images/p10.jpeg", "/images/p11.jpeg", "/images/p12.jpeg", "/images/p15.jpeg", "/images/p16.jpeg"];

const title = "Productos";
const subTitle =
  "En ARCHIPIER BUILDER SUPPLY ofrecemos materiales premium: aluminio, madera y metal. Explora nuestras categorías.";

const pageTitle = `Productos | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  lang="es"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/fr/products`,
    url: `${SITE.url}/fr/products`,
    name: `Productos | ${SITE.title}`,
    description: "Materiales de construcción premium: aluminio, madera y metal. ARCHIPIER BUILDER SUPPLY.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: "es",
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-8 md:mb-12">
      <h1
        class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
      >
        {title}
      </h1>
      {
        subTitle && (
          <p class="mt-2 max-w-screen-sm text-pretty text-neutral-600 dark:text-neutral-400 md:block">
            {subTitle}
          </p>
        )
      }
    </div>

    <!-- Sección: Aluminio — fotos de public/images -->
    <section id="aluminio" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Aluminio
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Puertas y ventanas de aluminio premium. Calidad y durabilidad para tu proyecto.
      </p>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6 lg:grid-cols-5">
        {
          aluminioImages.map((src) => (
            <div class="overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-700">
              <img
                src={src}
                alt="Producto aluminio"
                class="h-48 w-full object-cover"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Sección: Madera — sin Almendro/Ana Caspi -->
    <section id="madera" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Madera
      </h2>
      {
        productsMadera.length > 0 ? (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
            {
              productsMadera.map((product, index) => {
                const position = index % 4;
                if (position === 0 || position === 3) {
                  return <CardSmall product={product} productLocale="fr" />;
                } else {
                  return <CardWide product={product} productLocale="fr" />;
                }
              })
            }
          </div>
        ) : (
          <p class="text-neutral-600 dark:text-neutral-400">
            Próximamente. Productos de madera premium.
          </p>
        )
      }
    </section>

    <!-- Sección: Metal — fotos de public/images -->
    <section id="metal" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Metal
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Puertas y herrajes de metal premium. Resistencia y acabado para cada aplicación.
      </p>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6 lg:grid-cols-5">
        {
          metalImages.map((src) => (
            <div class="overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-700">
              <img
                src={src}
                alt="Producto metal"
                class="h-48 w-full object-cover"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</MainLayout>
