---
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";
import { getProductBySlug, getAllSlugs, isValidProductSlug } from "@data/products";
import { getCollection } from "astro:content";

const WHATSAPP_NUMBER = "51975733744";

export async function getStaticPaths() {
  const paths: { params: { id: string }; props: { product?: import("@data/products").Product; redirectTo?: string } }[] = [];

  // New data-file products (ficha con precios, beneficios, detalles)
  for (const slug of getAllSlugs()) {
    const product = getProductBySlug(slug)!;
    paths.push({ params: { id: slug }, props: { product } });
  }

  // Legacy content-collection IDs → redirect to /products
  const legacyEntries = await getCollection("products", ({ id }) => id.startsWith("en/"));
  for (const entry of legacyEntries) {
    const idWithoutLang = entry.id.replace(/^en\//, "");
    if (!isValidProductSlug(idWithoutLang)) {
      paths.push({ params: { id: idWithoutLang }, props: { redirectTo: "/products" } });
    }
  }

  return paths;
}

const { product: productProp, redirectTo } = Astro.props;

if (redirectTo) {
  return Astro.redirect(redirectTo);
}

const product = productProp!;
const pageTitle = `${product.nameEn} | ${SITE.title}`;
const whatsappMessage = encodeURIComponent(`Hi, I'm interested in: ${product.nameEn}. I'd like to know price and availability.`);
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${whatsappMessage}`;
---

<MainLayout
  title={pageTitle}
  lang="en"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.nameEn,
    description: product.detailsEn,
    image: new URL(product.image, SITE.url).toString(),
  }}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <a href="/products" class="mb-6 inline-flex items-center text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400">
      ← Back to Products
    </a>

    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
        <img
          src={product.image}
          alt={product.nameEn}
          class="h-auto w-full object-cover"
          width="600"
          height="400"
          loading="eager"
        />
      </div>

      <div>
        <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white md:text-4xl">
          {product.nameEn}
        </h1>
        <p class="mt-3 text-neutral-600 dark:text-neutral-400">
          {product.detailsEn}
        </p>

        <div class="mt-8 flex flex-wrap items-baseline gap-6 border-y border-neutral-200 dark:border-neutral-700 py-6">
          <div>
            <span class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Price (PEN)</span>
            <p class="text-2xl font-bold text-neutral-900 dark:text-white">S/ {product.pricePen.toLocaleString()}</p>
          </div>
          {
            product.priceUsd != null && (
              <div>
                <span class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Price (USD)</span>
                <p class="text-2xl font-bold text-neutral-900 dark:text-white">$ {product.priceUsd.toLocaleString()}</p>
              </div>
            )
          }
        </div>

        {
          product.measures && (product.measures.width || product.measures.height || product.measures.depth) && (
            <div class="mt-6">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Measures</h2>
              <ul class="mt-2 flex flex-wrap gap-4 text-neutral-700 dark:text-neutral-300">
                {product.measures.width && <li><span class="text-neutral-500 dark:text-neutral-400">Width:</span> {product.measures.width}</li>}
                {product.measures.height && <li><span class="text-neutral-500 dark:text-neutral-400">Height:</span> {product.measures.height}</li>}
                {product.measures.depth && <li><span class="text-neutral-500 dark:text-neutral-400">Depth:</span> {product.measures.depth}</li>}
                {product.measures.weight && <li><span class="text-neutral-500 dark:text-neutral-400">Weight:</span> {product.measures.weight}</li>}
              </ul>
            </div>
          )
        }

        <div class="mt-8">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Benefits</h2>
          <ul class="mt-3 space-y-2">
            {
              product.benefitsEn.map((benefit) => (
                <li class="flex items-start gap-2 text-neutral-700 dark:text-neutral-300">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-500" aria-hidden="true" />
                  {benefit}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-10">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg bg-green-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
          >
            Get quote · WhatsApp
          </a>
          <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
            Request price and availability. We respond quickly.
          </p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
