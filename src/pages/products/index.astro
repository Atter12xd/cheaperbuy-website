---
import MainLayout from "@/layouts/MainLayout.astro";
import ProductCard from "@components/ui/cards/ProductCard.astro";
import { SITE } from "@data/constants";
import { getProductsByCategory } from "@data/products";

const title = "Products";
const subTitle =
  "At ARCHIPIER BUILDER SUPPLY we offer premium materials: aluminum, wood, and metal. Click on any product to see prices, benefits and details.";

const aluminioProducts = getProductsByCategory("aluminum");
const maderaProducts = getProductsByCategory("wood");
const metalProducts = getProductsByCategory("metal");
---

<MainLayout
  title={`Products | ${SITE.title}`}
  lang="en"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/products`,
    url: `${SITE.url}/products`,
    name: `Products | ${SITE.title}`,
    description: "Premium construction materials: aluminum, wood, and metal. ARCHIPIER BUILDER SUPPLY.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: "en",
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-8 md:mb-12">
      <h1
        class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
      >
        {title}
      </h1>
      {
        subTitle && (
          <p class="mt-2 max-w-screen-sm text-pretty text-neutral-600 dark:text-neutral-400 md:block">
            {subTitle}
          </p>
        )
      }
    </div>

    <section id="aluminio" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Aluminum
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Premium aluminum doors and windows. Click on a product to see prices, benefits and details.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          aluminioProducts.map((product) => (
            <ProductCard product={product} locale="en" />
          ))
        }
      </div>
    </section>

    <section id="madera" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Wood
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Premium wood products. Click on a product to see prices, benefits and details.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          maderaProducts.map((product) => (
            <ProductCard product={product} locale="en" />
          ))
        }
      </div>
    </section>

    <section id="metal" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Metal
      </h2>
      <p class="mb-6 text-neutral-600 dark:text-neutral-400">
        Premium metal doors and hardware. Click on a product to see prices, benefits and details.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          metalProducts.map((product) => (
            <ProductCard product={product} locale="en" />
          ))
        }
      </div>
    </section>
  </div>
</MainLayout>
