---
import MainLayout from "@/layouts/MainLayout.astro";
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import CardSmall from "@components/ui/cards/CardSmall.astro";
import CardWide from "@components/ui/cards/CardWide.astro";
import FeaturesStatsAlt from "@components/sections/features/FeaturesStatsAlt.astro";
import TestimonialsSectionAlt from "@components/sections/testimonials/TestimonialsSectionAlt.astro";
import { SITE } from "@data/constants";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

// English products page: use content with id starting with "en/"
const allProducts: CollectionEntry<"products">[] = (
  await getCollection("products", ({ id }) => id.startsWith("en/"))
).sort(
  (a: CollectionEntry<"products">, b: CollectionEntry<"products">) =>
    a.data.main.id - b.data.main.id
);

// For Day 1: no category in schema yet — show wood products in Madera section, placeholders for Aluminio/Metal
const productsMadera = allProducts;

const title = "Products";
const subTitle =
  "At ARCHIPIER BUILDER SUPPLY we offer premium materials: aluminum, wood, and metal. Browse our categories below.";

const testimonials = [
  {
    content:
      "\"Since I started working with ARCHIPIER BUILDER SUPPLY, the quality of my projects has improved significantly. Their products are durable, elegant, and easy to install. Highly recommended!\"",
    author: "Carlos Mendoza",
    role: "Architect | Mendoza & Associates",
    avatarSrc:
      "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1374&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80",
    avatarAlt: "Image Description",
  },
  {
    content:
      "\"As a designer, I always look for high-quality materials. ARCHIPIER BUILDER SUPPLY has been key in my projects, offering impeccable finishes and a wide range of options.\"",
    author: "María González",
    role: "Interior Designer | Creative Spaces",
    avatarSrc:
      "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=1376&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80",
    avatarAlt: "Image Description",
  },
  {
    content:
      "\"I have been in carpentry for over 15 years. ARCHIPIER BUILDER SUPPLY products are among the best I have used. Plus, their customer service is outstanding.\"",
    author: "Richard Kim",
    role: "Professional Carpenter | WoodWright",
    avatarSrc:
      "https://images.unsplash.com/photo-1474176857210-7287d38d27c6?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80",
    avatarAlt: "Image Description",
  },
];
---

<MainLayout
  title={`Products | ${SITE.title}`}
  lang="en"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/products`,
    url: `${SITE.url}/products`,
    name: `Products | ${SITE.title}`,
    description: "Premium construction materials: aluminum, wood, and metal. ARCHIPIER BUILDER SUPPLY.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: "en",
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1
          class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
        >
          {title}
        </h1>
        {
          subTitle && (
            <p class="hidden max-w-screen-sm text-pretty text-neutral-600 dark:text-neutral-400 md:block">
              {subTitle}
            </p>
          )
        }
      </div>
      <PrimaryCTA title="Customer Stories" url="#testimonials" noArrow={true} />
    </div>

    <!-- Section: Aluminum -->
    <section id="aluminio" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Aluminum
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400">
        Coming soon. Premium aluminum doors and windows.
      </p>
    </section>

    <!-- Section: Wood -->
    <section id="madera" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Wood
      </h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
        {
          productsMadera.map((product, index) => {
            const position = index % 4;
            if (position === 0 || position === 3) {
              return <CardSmall product={product} productLocale="en" />;
            } else {
              return <CardWide product={product} productLocale="en" />;
            }
          })
        }
      </div>
    </section>

    <!-- Section: Metal -->
    <section id="metal" class="scroll-mt-24 pb-12 md:pb-16">
      <h2 class="mb-6 text-xl font-semibold text-neutral-800 dark:text-neutral-200 md:text-2xl">
        Metal
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400">
        Coming soon. Premium metal doors and hardware.
      </p>
    </section>
  </div>

  <FeaturesStatsAlt
    title="Why Choose ARCHIPIER BUILDER SUPPLY?"
    subTitle="Turn your ideas into reality with our products. Whether you're renovating your home or working on a large-scale project, our high-quality materials are designed to provide strength, elegance, and durability."
    benefits={[
      "Durable and long-lasting materials.",
      "Innovative solutions tailored to any project.",
      "Personalized support to ensure your satisfaction.",
    ]}
  />
  <TestimonialsSectionAlt
    title="What Our Customers Say"
    testimonials={testimonials}
  />
</MainLayout>
