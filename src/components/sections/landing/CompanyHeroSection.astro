---
import ReviewComponent from "@components/ui/blocks/ReviewComponent.astro";

const {
  withReview,
  avatars,
  starCount,
  rating,
  reviews
} = Astro.props;

interface Props {
  withReview?: boolean;
  avatars?: Array<string>;
  starCount?: number;
  rating?: string;
  reviews?: string;
}
---

<!-- Hero Section de Presentación de Empresa -->
<section class="relative mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 2xl:max-w-full">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 xl:gap-20 items-center">
    
    <!-- Contenido Principal de la Empresa -->
    <div class="flex flex-col justify-center order-2 lg:order-1">
      
      <!-- Badge de Experiencia -->
      <div class="inline-block px-4 py-2 mb-6 text-sm font-semibold text-wood-700 bg-wood-50 dark:bg-wood-900 dark:text-wood-300 rounded-lg border border-wood-200 dark:border-wood-700 w-fit">
        {Astro.currentLocale === "en" ? "Specialists since 2015" : "Especialistas desde 2015"}
      </div>

      <!-- Título Principal -->
      <h1 class="text-4xl font-bold text-primary-800 dark:text-primary-100 sm:text-5xl lg:text-6xl leading-tight mb-6">
        <span class="text-wood-600 dark:text-wood-400">ARCHIPIER</span><br>
        <span class="text-primary-700 dark:text-primary-200">BUILDER SUPPLY</span>
      </h1>

      <!-- Subtítulo con Especialidades -->
      <div class="text-xl text-primary-600 dark:text-primary-300 lg:w-4/5 leading-relaxed mb-8">
        {Astro.currentLocale === "en" 
          ? <Fragment>We work with <strong class='text-wood-600 dark:text-wood-400'>aluminum, steel, and wood carpentry</strong>. International shipping available with our main office in Peru and distributors in Mexico, United States, and Canada.</Fragment>
          : <Fragment>Trabajamos con <strong class='text-wood-600 dark:text-wood-400'>carpintería de aluminio, acero y madera</strong>. Realizamos envíos internacionales con nuestra sede principal en Perú y distribuidoras en México, Estados Unidos y Canadá.</Fragment>
        }
      </div>

      <!-- Características Principales -->
      <div class="mb-8 grid grid-cols-1 sm:grid-cols-2 gap-6 text-primary-700 dark:text-primary-300">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 bg-wood-600 rounded-full flex items-center justify-center mt-1 flex-shrink-0">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <span class="font-semibold block">
              {Astro.currentLocale === "en" ? "10-Year Warranty" : "Garantía de 10 Años"}
            </span>
            <span class="text-sm text-primary-500 dark:text-primary-400">
              {Astro.currentLocale === "en" ? "On all our products" : "En todos nuestros productos"}
            </span>
          </div>
        </div>
        
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 bg-wood-600 rounded-full flex items-center justify-center mt-1 flex-shrink-0">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <span class="font-semibold block">
              {Astro.currentLocale === "en" ? "International Shipping" : "Envíos Internacionales"}
            </span>
            <span class="text-sm text-primary-500 dark:text-primary-400">
              {Astro.currentLocale === "en" ? "To USA, Mexico & Canada" : "A USA, México y Canadá"}
            </span>
          </div>
        </div>
        
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 bg-wood-600 rounded-full flex items-center justify-center mt-1 flex-shrink-0">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <span class="font-semibold block">
              {Astro.currentLocale === "en" ? "Professional Installation" : "Instalación Profesional"}
            </span>
            <span class="text-sm text-primary-500 dark:text-primary-400">
              {Astro.currentLocale === "en" ? "Expert certified team" : "Equipo experto certificado"}
            </span>
          </div>
        </div>
        
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 bg-wood-600 rounded-full flex items-center justify-center mt-1 flex-shrink-0">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <span class="font-semibold block">
              {Astro.currentLocale === "en" ? "Custom Projects" : "Proyectos Personalizados"}
            </span>
            <span class="text-sm text-primary-500 dark:text-primary-400">
              {Astro.currentLocale === "en" ? "Tailored to your needs" : "Adaptados a tus necesidades"}
            </span>
          </div>
        </div>
      </div>

    <!-- Especialidades -->
<div class="mb-8">
  <h3 class="text-lg font-semibold text-primary-700 dark:text-primary-300 mb-6">
    {Astro.currentLocale === "en" ? "Our Specialties:" : "Nuestras Especialidades:"}
  </h3>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    
    <!-- Botón Aluminio (1) -->
     <a  href={Astro.currentLocale === "fr" ? "/fr/aluminio" : "/aluminio"}
      class="group inline-flex items-center justify-center px-6 py-4 text-sm font-semibold text-white bg-gradient-to-r from-wood-600 to-wood-700 rounded-lg hover:from-wood-700 hover:to-wood-800 transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      {Astro.currentLocale === "en" ? "Aluminum Products" : "Productos de Aluminio"}
      <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>

    <!-- Botón Madera (2) -->
      <a href={Astro.currentLocale === "fr" ? "/fr/madera" : "/madera"}
      class="group inline-flex items-center justify-center px-6 py-4 text-sm font-semibold text-white bg-gradient-to-r from-wood-600 to-wood-700 rounded-lg hover:from-wood-700 hover:to-wood-800 transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
      </svg>
      {Astro.currentLocale === "en" ? "Premium Wood" : "Productos de Madera"}
      <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>

    <!-- Botón Metal (3) -->
     <a  href={Astro.currentLocale === "fr" ? "/fr/metal" : "/metal"}
      class="group inline-flex items-center justify-center px-6 py-4 text-sm font-semibold text-white bg-gradient-to-r from-primary-700 to-primary-800 rounded-lg hover:from-primary-800 hover:to-primary-900 transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
    >
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 9.172V5L8 4z"></path>
      </svg>
      {Astro.currentLocale === "en" ? "Metal Products" : "Productos de Metal"}
      <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>

  </div>
</div>

      <!-- Botones CTA -->
      <div class="flex flex-col sm:flex-row gap-4 mb-8">
       
        
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-primary-700 dark:text-primary-300 bg-transparent border-2 border-primary-300 dark:border-primary-600 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-300"
        >
          {Astro.currentLocale === "en" ? "Request Quote" : "Solicitar Cotización"}
        </a>
      </div>

      <!-- Sección de reseñas -->
      {withReview && (
        <div class="p-6 bg-primary-50 dark:bg-primary-800 rounded-lg border border-primary-200 dark:border-primary-700">
          <ReviewComponent avatars={avatars} starCount={starCount} rating={rating} reviews={reviews} />
        </div>
      )}
    </div>

    <!-- Sección de Imagen (visible siempre) -->
    <div class="order-1 lg:order-2">
      <div class="sticky top-8">
        <div class="relative bg-gradient-to-br from-primary-800 to-primary-900 rounded-2xl overflow-hidden shadow-2xl border border-primary-700">
          <div class="aspect-[4/3] w-full">
            <img
              id="mainCompanyImage"
              src="/images/p1-1.jpeg"
              alt="ArchipiIer Builder Supply Projects"
              class="w-full h-full object-cover transition-all duration-1000 ease-in-out"
              loading="eager"
            />
            
            <!-- Overlay degradado mejorado -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          </div>
          
          <!-- Información del proyecto con mejor diseño -->
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <div class="backdrop-blur-sm bg-black/30 rounded-lg p-4 border border-white/10">
              <h3 class="text-white font-bold text-xl mb-2 leading-tight" id="projectTitle">
                {Astro.currentLocale === "en" ? "Premium Construction Projects" : "Proyectos de Construcción Premium"}
              </h3>
              <p class="text-white/90 text-sm leading-relaxed" id="projectDescription">
                {Astro.currentLocale === "en" ? "Quality materials for exceptional results" : "Materiales de calidad para resultados excepcionales"}
              </p>
              
              <!-- Barra de progreso para indicar rotación -->
              <div class="mt-3 flex items-center gap-3">
                <div class="flex-1 bg-white/20 rounded-full h-1 overflow-hidden">
                  <div class="h-full bg-white/80 rounded-full transition-all duration-[4000ms] ease-linear" id="progressBar" style="width: 0%"></div>
                </div>
                <span class="text-white/70 text-xs font-medium" id="imageCounter">1/6</span>
              </div>
            </div>
          </div>

          <!-- Indicadores mejorados -->
          <div class="absolute top-6 right-6 flex flex-col gap-2">
            <div class="w-3 h-3 bg-white/90 rounded-full transition-all duration-300 shadow-lg" id="companyIndicator1"></div>
            <div class="w-3 h-3 bg-white/30 rounded-full transition-all duration-300 shadow-lg" id="companyIndicator2"></div>
            <div class="w-3 h-3 bg-white/30 rounded-full transition-all duration-300 shadow-lg" id="companyIndicator3"></div>
            <div class="w-3 h-3 bg-white/30 rounded-full transition-all duration-300 shadow-lg" id="companyIndicator4"></div>
            <div class="w-3 h-3 bg-white/30 rounded-full transition-all duration-300 shadow-lg" id="companyIndicator5"></div>
            <div class="w-3 h-3 bg-white/30 rounded-full transition-all duration-300 shadow-lg" id="companyIndicator6"></div>
          </div>
          
          <!-- Badge de especialidad flotante -->
          <div class="absolute top-6 left-6">
            <span class="px-3 py-1 bg-wood-600/90 backdrop-blur-sm text-white text-xs font-semibold rounded-full border border-wood-400/30">
              {Astro.currentLocale === "en" ? "Premium Quality" : "Calidad Premium"}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Order: Aluminum, Wood, Metal first
    const companyImages = [
      {
        src: "/images/p1-1.jpeg",
        title: Astro.currentLocale === "en" ? "Premium Aluminum Doors" : "Puertas de Aluminio Premium",
        description: Astro.currentLocale === "en" ? "Modern and resistant designs" : "Diseños modernos y resistentes"
      },
      {
        src: "/images/p3.jpeg",
        title: Astro.currentLocale === "en" ? "Noble Wood Floors" : "Pisos de Madera Noble",
        description: Astro.currentLocale === "en" ? "Natural elegance for your home" : "Elegancia natural para tu hogar"
      },
      {
        src: "/images/p1-2.jpeg",
        title: Astro.currentLocale === "en" ? "Metal Structures" : "Estructuras de Metal",
        description: Astro.currentLocale === "en" ? "Solid and durable construction" : "Construcción sólida y duradera"
      },
      {
        src: "/images/p4.jpeg",
        title: Astro.currentLocale === "en" ? "Aluminum Windows" : "Ventanas de Aluminio",
        description: Astro.currentLocale === "en" ? "Lighting and energy efficiency" : "Iluminación y eficiencia energética"
      },
      {
        src: "/images/p1-3.jpeg",
        title: Astro.currentLocale === "en" ? "Custom Carpentry" : "Carpintería Personalizada",
        description: Astro.currentLocale === "en" ? "Unique custom projects" : "Proyectos únicos a medida"
      },
      {
        src: "/images/p6.jpeg",
        title: Astro.currentLocale === "en" ? "Professional Finishes" : "Acabados Profesionales",
        description: Astro.currentLocale === "en" ? "Guaranteed quality in every detail" : "Calidad garantizada en cada detalle"
      }
    ];

    let currentCompanyIndex = 0;
    const companyImage = document.getElementById('mainCompanyImage') as HTMLImageElement;
    const projectTitle = document.getElementById('projectTitle') as HTMLElement;
    const projectDescription = document.getElementById('projectDescription') as HTMLElement;
    const progressBar = document.getElementById('progressBar') as HTMLElement;
    const imageCounter = document.getElementById('imageCounter') as HTMLElement;
    const indicators = ['companyIndicator1', 'companyIndicator2', 'companyIndicator3', 'companyIndicator4', 'companyIndicator5', 'companyIndicator6'];

    function updateCompanyImage(): void {
      if (companyImage && projectTitle && projectDescription && progressBar && imageCounter) {
        const currentData = companyImages[currentCompanyIndex];
        
        // Actualizar contenido
        companyImage.src = currentData.src;
        projectTitle.textContent = currentData.title;
        projectDescription.textContent = currentData.description;
        imageCounter.textContent = `${currentCompanyIndex + 1}/6`;
        
        // Reiniciar y animar barra de progreso
        progressBar.style.width = '0%';
        setTimeout(() => {
          progressBar.style.width = '100%';
        }, 100);
        
        // Actualizar indicadores
        indicators.forEach((id, index) => {
          const indicator = document.getElementById(id);
          if (indicator) {
            if (index === currentCompanyIndex) {
              indicator.style.backgroundColor = "rgba(255,255,255,0.9)";
              indicator.style.transform = "scale(1.2)";
            } else {
              indicator.style.backgroundColor = "rgba(255,255,255,0.3)";
              indicator.style.transform = "scale(1)";
            }
          }
        });
        
        currentCompanyIndex = (currentCompanyIndex + 1) % companyImages.length;
      }
    }

    // Inicializar
    updateCompanyImage();
    
    // Cambiar imagen cada 4 segundos
    setInterval(updateCompanyImage, 4000);
  });
</script>