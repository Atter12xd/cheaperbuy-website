---
import ReviewComponent from "@components/ui/blocks/ReviewComponent.astro";

const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  withReview,
  avatars,
  starCount,
  rating,
  reviews,
  src,
  alt
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  withReview?: boolean;
  avatars?: Array<string>;
  starCount?: number;
  rating?: string;
  reviews?: string;
  src?: Array<string>;
  alt?: string;
}

// Array de imágenes que se usarán
const mediaItems = [
  "/images/p1-1.jpeg",
  "/images/p1-2.jpeg", 
  "/images/p1-3.jpeg",
];
---

<!-- Hero Section Principal -->
<section class="hero-section relative mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 2xl:max-w-full">

  <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 xl:gap-16">
    
    <!-- Sección de Información del Producto -->
    <div class="flex flex-col justify-center order-2 lg:order-1">
      
      <!-- Breadcrumb -->
      <nav class="flex mb-4 text-sm text-neutral-600 dark:text-neutral-400">
        <a href="/" class="hover:text-wood-600 dark:hover:text-wood-400 transition-colors">
          {Astro.currentLocale === "en" ? "Home" : "Inicio"}
        </a>
        <span class="mx-2">/</span>
        <span class="text-wood-600 dark:text-wood-400 font-medium">
          {Astro.currentLocale === "en" ? "Premium Products" : "Productos Premium"}
        </span>
      </nav>

      <!-- Título del Producto -->
      <h1 class="text-3xl font-bold text-neutral-800 dark:text-neutral-100 sm:text-4xl lg:text-5xl leading-tight mb-4">
        <Fragment set:html={title} />
      </h1>

      <!-- Precio -->
      <div class="mb-6">
        <span class="text-3xl font-bold text-neutral-800 dark:text-neutral-100" id="displayPrice">
          {Astro.currentLocale === "en" ? "From $2,850.00" : "Desde S/. 2,850.00"}
        </span>
        <div class="text-sm text-red-600 font-medium mt-1">
          {Astro.currentLocale === "en" ? "Please hurry! Only 8 left in stock" : "¡Date prisa! Solo quedan 8 en stock"}
        </div>
      </div>

      <!-- Opciones de Tamaño -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-3">
          {Astro.currentLocale === "en" ? "Size:" : "Tamaño:"} 
          <span class="text-wood-600 dark:text-wood-400" id="selectedSizeDisplay">2.10m x 90cm</span>
        </h3>
        <div class="grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-3 xl:grid-cols-4">
          <button class="size-option px-3 py-2 text-sm border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300" data-size="1.80 x 80" data-price="2450">
            1.80 x 80
          </button>
          <button class="size-option px-3 py-2 text-sm border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300" data-size="1.80 x 90" data-price="2650">
            1.80 x 90
          </button>
          <button class="size-option px-3 py-2 text-sm border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300" data-size="2.00 x 80" data-price="2750">
            2.00 x 80
          </button>
          <button class="size-option px-3 py-2 text-sm border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300" data-size="2.00 x 90" data-price="2950">
            2.00 x 90
          </button>
          <button class="size-option px-3 py-2 text-sm border-2 border-wood-500 dark:border-wood-500 bg-wood-500 dark:bg-wood-500 text-white rounded-lg font-medium shadow-md transition-all duration-200" data-size="2.10 x 90" data-price="2850">
            2.10 x 90
          </button>
          <button class="size-option px-3 py-2 text-sm border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300" data-size="2.10 x 100" data-price="3150">
            2.10 x 100
          </button>
        </div>
      </div>

      <!-- Opciones de Material -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-3">
          {Astro.currentLocale === "en" ? "Material:" : "Material:"} 
          <span class="text-wood-600 dark:text-wood-400" id="selectedMaterialDisplay">
            {Astro.currentLocale === "en" ? "Solid Wood" : "Madera Sólida"}
          </span>
        </h3>
        <div class="grid grid-cols-2 gap-3">
          <button class="material-option px-4 py-3 text-sm border-2 border-wood-500 dark:border-wood-500 bg-wood-500 dark:bg-wood-500 text-white rounded-lg font-medium shadow-md transition-all duration-200" data-material="Solid Wood" data-material-es="Madera Sólida">
            {Astro.currentLocale === "en" ? "Solid Wood" : "Madera Sólida"}
          </button>
          <button class="material-option px-4 py-3 text-sm border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300" data-material="Steel Frame" data-material-es="Marco de Acero">
            {Astro.currentLocale === "en" ? "Steel Frame" : "Marco de Acero"}
          </button>
        </div>
      </div>

      <!-- Cantidad -->
      <div class="mb-6">
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-3">
          {Astro.currentLocale === "en" ? "Quantity:" : "Cantidad:"}
        </h3>
        <div class="flex items-center">
          <button class="w-10 h-10 border border-primary-300 dark:border-primary-600 rounded-l-lg hover:bg-primary-100 dark:hover:bg-primary-700 flex items-center justify-center" id="decreaseBtn">
            <span class="text-lg">-</span>
          </button>
          <input type="number" value="1" min="1" max="8" class="w-16 h-10 text-center border-t border-b border-primary-300 dark:border-primary-600 bg-white dark:bg-primary-800 text-primary-800 dark:text-primary-100" id="quantityInput">
          <button class="w-10 h-10 border border-primary-300 dark:border-primary-600 rounded-r-lg hover:bg-primary-100 dark:hover:bg-primary-700 flex items-center justify-center" id="increaseBtn">
            <span class="text-lg">+</span>
          </button>
        </div>
      </div>

      <!-- Subtotal -->
      <div class="mb-6 p-4 bg-primary-50 dark:bg-primary-800 rounded-lg">
        <div class="flex justify-between items-center">
          <span class="text-lg font-medium text-primary-700 dark:text-primary-300">
            {Astro.currentLocale === "en" ? "Subtotal:" : "Subtotal:"}
          </span>
          <span class="text-2xl font-bold text-primary-800 dark:text-primary-100" id="subtotalAmount">
            {Astro.currentLocale === "en" ? "$2,850.00" : "S/. 2,850.00"}
          </span>
        </div>
      </div>

      <!-- Botón de Carrito Personalizado -->
      <div class="mb-6" id="cart-button-container">
        <!-- El botón se insertará aquí via JavaScript -->
        <div class="w-full bg-gradient-to-r from-primary-800 to-primary-900 dark:from-primary-700 dark:to-primary-800 text-white py-4 px-6 rounded-lg font-semibold text-lg hover:from-primary-900 hover:to-black dark:hover:from-primary-600 dark:hover:to-primary-700 transition-all duration-300 shadow-brand hover:shadow-brand-lg transform hover:-translate-y-0.5 text-center cursor-pointer" id="add-to-cart-btn">
          <div class="flex items-center justify-center gap-3">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
            </svg>
            <span id="cart-btn-text">
              {Astro.currentLocale === "en" ? "ADD TO CART" : "AGREGAR AL CARRITO"}
            </span>
          </div>
          <div class="hidden" id="cart-loading">
            <svg class="animate-spin h-5 w-5 text-white mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <!-- Botones secundarios -->
      <div class="grid grid-cols-2 gap-4 mb-6">
        <button class="flex items-center justify-center gap-2 py-3 px-4 border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300 hover:text-primary-900 dark:hover:text-primary-100">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium">{Astro.currentLocale === "en" ? "Save" : "Guardar"}</span>
        </button>
        <button class="flex items-center justify-center gap-2 py-3 px-4 border-2 border-primary-200 dark:border-primary-700 rounded-lg hover:border-wood-400 dark:hover:border-wood-500 hover:bg-primary-50 dark:hover:bg-primary-800 transition-all duration-200 text-primary-700 dark:text-primary-300 hover:text-primary-900 dark:hover:text-primary-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
          </svg>
          <span class="text-sm font-medium">{Astro.currentLocale === "en" ? "Share" : "Compartir"}</span>
        </button>
      </div>

      <!-- Información adicional -->
      <div class="space-y-3 text-sm text-neutral-600 dark:text-neutral-400">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-success-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span class="font-medium">
            {Astro.currentLocale === "en" ? "Fast Nationwide Shipping" : "Envío Rápido Nacional"}
          </span>
        </div>
        <div class="text-xs ml-8">
          {Astro.currentLocale === "en" ? "Stock Items Usually Ship Within 1-3 Days" : "Productos en Stock se Envían en 1-3 Días"}
        </div>
        
        <div class="flex items-center gap-3 mt-4">
          <svg class="w-5 h-5 text-wood-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
          </svg>
          <span class="font-medium">
            {Astro.currentLocale === "en" ? "Want To Customize It?" : "¿Quieres Personalizarlo?"}
          </span>
        </div>
        <div class="text-xs ml-8">
          {Astro.currentLocale === "en" ? "Contact Us Below To Build Your Own" : "Contáctanos para Crear el Tuyo Propio"}
        </div>
      </div>

      <!-- Sección de reseñas si está habilitada -->
      {withReview && (
        <div class="mt-8 p-4 bg-primary-50 dark:bg-primary-800 rounded-lg border border-primary-200 dark:border-primary-700">
          <ReviewComponent avatars={avatars} starCount={starCount} rating={rating} reviews={reviews} />
        </div>
      )}
    </div>

    <!-- Sección de Imagen Principal con Galería -->
    <div class="order-1 lg:order-2">
      <div class="sticky top-8">
        <!-- Imagen Principal -->
        <div class="mb-4">
          <div class="relative bg-white dark:bg-primary-800 rounded-lg overflow-hidden shadow-brand-lg border border-primary-200 dark:border-primary-700">
            <div class="aspect-square w-full">
              <img
                id="mainImage"
                src="/images/p1-1.jpeg"
                alt={alt || "Producto premium"}
                class="w-full h-full object-cover transition-all duration-300 cursor-zoom-in"
                loading="eager"
              />
            </div>
            
            <!-- Botones de navegación -->
            <button 
              id="prevBtn"
              class="absolute left-2 top-1/2 transform -translate-y-1/2 w-10 h-10 bg-white/80 dark:bg-black/80 rounded-full shadow-lg flex items-center justify-center hover:bg-white dark:hover:bg-black transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
            
            <button 
              id="nextBtn"
              class="absolute right-2 top-1/2 transform -translate-y-1/2 w-10 h-10 bg-white/80 dark:bg-black/80 rounded-full shadow-lg flex items-center justify-center hover:bg-white dark:hover:bg-black transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>

            <!-- Indicador de imagen actual -->
            <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 bg-black/50 text-white px-3 py-1 rounded-full text-sm">
              <span id="currentImageNumber">1</span> / {mediaItems.length}
            </div>
          </div>
        </div>

        <!-- Thumbnails -->
        <div class="grid grid-cols-6 gap-2">
          {mediaItems.map((item, index) => (
            <button 
              class={`thumbnail relative aspect-square rounded-lg overflow-hidden border-2 transition-all duration-200 ${index === 0 ? 'border-wood-600 ring-2 ring-wood-600/20' : 'border-primary-200 dark:border-primary-700 hover:border-wood-400'}`}
              data-index={index}
            >
              <img
                src={item}
                alt={`Vista ${index + 1}`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script mejorado con funcionalidad de carrito -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mediaItems = [
      "/images/p1-1.jpeg",
      "/images/p1-2.jpeg", 
      "/images/p1-3.jpeg",
    ];
    
    let currentIndex = 0;
    let currentPrice = 2850;
    let selectedSize = "2.10 x 90";
    let selectedMaterial = "Madera Sólida";
    
    const mainImage = document.getElementById('mainImage') as HTMLImageElement;
    const currentImageNumber = document.getElementById('currentImageNumber');
    const thumbnails = document.querySelectorAll('.thumbnail');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const addToCartBtn = document.getElementById('add-to-cart-btn');
    const cartBtnText = document.getElementById('cart-btn-text');
    const cartLoading = document.getElementById('cart-loading');
    
    // Función para manejar agregar al carrito
   async function handleAddToCart() {
  if (!addToCartBtn || !cartBtnText || !cartLoading) return;
  
  const quantityInput = document.getElementById('quantityInput') as HTMLInputElement;
  const quantity = parseInt(quantityInput?.value || '1');
  
  // Mostrar loading
  cartBtnText.classList.add('hidden');
  cartLoading.classList.remove('hidden');
  addToCartBtn.style.pointerEvents = 'none';
  
  try {
    // LLAMADA REAL A SUPABASE
    const productOptions = {
      size: selectedSize,
      material: selectedMaterial,
      price: currentPrice
    };

    // Obtener session ID
    let sessionId = localStorage.getItem('archiper_cart_session');
    if (!sessionId) {
      sessionId = `archiper_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
      localStorage.setItem('archiper_cart_session', sessionId);
    }

    // Agregar producto al carrito en Supabase
    const response = await fetch('/api/add-to-cart', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        sessionId,
        productId: 'arch-alu-001',
        quantity,
        productOptions
      }),
    });

    if (response.ok) {
      // Mostrar éxito
      cartBtnText.textContent = '¡AGREGADO!';
      cartBtnText.classList.remove('hidden');
      cartLoading.classList.add('hidden');
      addToCartBtn.classList.add('bg-green-600', 'from-green-600', 'to-green-700');
      
      setTimeout(() => {
        cartBtnText.textContent = document.documentElement.lang === 'en' ? 'ADD TO CART' : 'AGREGAR AL CARRITO';
        addToCartBtn.classList.remove('bg-green-600', 'from-green-600', 'to-green-700');
        addToCartBtn.style.pointerEvents = 'auto';
      }, 2000);
    } else {
      throw new Error('Error adding to cart');
    }
    
  } catch (error) {
    console.error('Error adding to cart:', error);
    cartBtnText.textContent = 'ERROR';
        cartBtnText.classList.remove('hidden');
        cartLoading.classList.add('hidden');
        
        setTimeout(() => {
          cartBtnText.textContent = document.documentElement.lang === 'en' ? 'ADD TO CART' : 'AGREGAR AL CARRITO';
          addToCartBtn.style.pointerEvents = 'auto';
        }, 2000);
      }
    }
    
    // Event listener para el botón de carrito
    if (addToCartBtn) {
      addToCartBtn.addEventListener('click', handleAddToCart);
    }
    
    function updateMainImage(index: number) {
      if (mainImage) {
        mainImage.src = mediaItems[index];
        currentIndex = index;
        
        if (currentImageNumber) {
          currentImageNumber.textContent = (index + 1).toString();
        }
        
        thumbnails.forEach((thumb, i) => {
          if (i === index) {
            thumb.classList.remove('border-primary-200', 'dark:border-primary-700');
            thumb.classList.add('border-wood-600', 'ring-2', 'ring-wood-600/20');
          } else {
            thumb.classList.remove('border-wood-600', 'ring-2', 'ring-wood-600/20');
            thumb.classList.add('border-primary-200', 'dark:border-primary-700');
          }
        });
      }
    }
    
    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => {
        updateMainImage(index);
      });
    });
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const newIndex = currentIndex > 0 ? currentIndex - 1 : mediaItems.length - 1;
        updateMainImage(newIndex);
      });
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const newIndex = currentIndex < mediaItems.length - 1 ? currentIndex + 1 : 0;
        updateMainImage(newIndex);
      });
    }
    
    let autoRotateInterval = setInterval(() => {
      const newIndex = currentIndex < mediaItems.length - 1 ? currentIndex + 1 : 0;
      updateMainImage(newIndex);
    }, 4000);
    
    const container = document.querySelector('.order-1');
    if (container) {
      container.addEventListener('mouseenter', () => {
        clearInterval(autoRotateInterval);
      });
      
      container.addEventListener('mouseleave', () => {
        autoRotateInterval = setInterval(() => {
          const newIndex = currentIndex < mediaItems.length - 1 ? currentIndex + 1 : 0;
          updateMainImage(newIndex);
        }, 4000);
      });
    }
    
    const sizeOptions = document.querySelectorAll('.size-option');
    const selectedSizeDisplay = document.getElementById('selectedSizeDisplay');
    const displayPrice = document.getElementById('displayPrice');
    
    sizeOptions.forEach(option => {
      option.addEventListener('click', function(this: HTMLElement) {
        sizeOptions.forEach(opt => {
          opt.classList.remove('border-wood-500', 'dark:border-wood-500', 'bg-wood-500', 'dark:bg-wood-500', 'text-white', 'shadow-md');
          opt.classList.add('border-primary-200', 'dark:border-primary-700', 'text-primary-700', 'dark:text-primary-300');
        });
        
        this.classList.remove('border-primary-200', 'dark:border-primary-700', 'text-primary-700', 'dark:text-primary-300');
        this.classList.add('border-wood-500', 'dark:border-wood-500', 'bg-wood-500', 'dark:bg-wood-500', 'text-white', 'shadow-md');
        
        selectedSize = this.getAttribute('data-size') || selectedSize;
        const selectedPrice = parseInt(this.getAttribute('data-price') || '2850');
        
        if (selectedSizeDisplay) {
          selectedSizeDisplay.textContent = selectedSize + 'cm';
        }
        
        currentPrice = selectedPrice;
        updateSubtotal();
        
        // Actualizar precio principal
        if (displayPrice) {
          const locale = document.documentElement.lang === 'en' ? 'en-US' : 'es-PE';
          const symbol = document.documentElement.lang === 'en' ? 'From $' : 'Desde S/. ';
          displayPrice.textContent = symbol + selectedPrice.toLocaleString(locale, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          });
        }
      });
    });
    
    const materialOptions = document.querySelectorAll('.material-option');
    const selectedMaterialDisplay = document.getElementById('selectedMaterialDisplay');
    
    
    materialOptions.forEach(option => {
  option.addEventListener('click', function(this: HTMLElement) {
        materialOptions.forEach(opt => {
          opt.classList.remove('border-wood-500', 'dark:border-wood-500', 'bg-wood-500', 'dark:bg-wood-500', 'text-white', 'shadow-md');
          opt.classList.add('border-primary-200', 'dark:border-primary-700', 'text-primary-700', 'dark:text-primary-300');
        });
        
        this.classList.remove('border-primary-200', 'dark:border-primary-700', 'text-primary-700', 'dark:text-primary-300');
        this.classList.add('border-wood-500', 'dark:border-wood-500', 'bg-wood-500', 'dark:bg-wood-500', 'text-white', 'shadow-md');
        
        const isSpanish = document.documentElement.lang === 'es';
        const selectedMaterial = isSpanish ? 
          this.getAttribute('data-material-es') : 
          this.getAttribute('data-material');
        
        if (selectedMaterialDisplay && selectedMaterial) {
          selectedMaterialDisplay.textContent = selectedMaterial;
        }
      });
    });
    
    const decreaseBtn = document.getElementById('decreaseBtn');
    const increaseBtn = document.getElementById('increaseBtn');
    const quantityInput = document.getElementById('quantityInput') as HTMLInputElement;
    const subtotalAmount = document.getElementById('subtotalAmount');
    
    function updateSubtotal() {
      if (quantityInput && subtotalAmount) {
        const quantity = parseInt(quantityInput.value) || 1;
        const total = currentPrice * quantity;
        const locale = document.documentElement.lang === 'en' ? 'en-US' : 'es-PE';
        const symbol = document.documentElement.lang === 'en' ? '$' : 'S/. ';
        
        subtotalAmount.textContent = symbol + total.toLocaleString(locale, {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        });
      }
    }
    
    if (decreaseBtn && quantityInput) {
      decreaseBtn.addEventListener('click', () => {
        const current = parseInt(quantityInput.value) || 1;
        if (current > 1) {
          quantityInput.value = (current - 1).toString();
          updateSubtotal();
        }
      });
    }
    
    if (increaseBtn && quantityInput) {
      increaseBtn.addEventListener('click', () => {
        const current = parseInt(quantityInput.value) || 1;
        const max = parseInt(quantityInput.getAttribute('max') || '8');
        if (current < max) {
          quantityInput.value = (current + 1).toString();
          updateSubtotal();
        }
      });
    }
    
    if (quantityInput) {
      quantityInput.addEventListener('input', updateSubtotal);
    }
  });
</script>