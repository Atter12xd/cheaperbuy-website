---
import { Image } from "astro:assets";
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import ReviewComponent from "@components/ui/blocks/ReviewComponent.astro";
import heroImage from "@images/casa1.jpeg";
import foRo1 from "@images/fo-ro1.jpeg";
import foRo2 from "@images/fo-ro2.jpeg";
import foRo3 from "@images/fo-ro3.jpeg";

const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  withReview,
  avatars,
  starCount,
  rating,
  reviews,
  src,
  alt
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  withReview?: boolean;
  avatars?: Array<string>;
  starCount?: number;
  rating?: string;
  reviews?: string;
  src?: any;
  alt?: string;
}

---

<!-- Sección principal profesional y elegante -->
<section
  class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 2xl:max-w-full grid gap-8 md:grid-cols-2 md:items-center"
>
  <!-- Sección de texto profesional -->
  <div>
    <!-- Distintivo de calidad sutil -->
    <div class="inline-block px-4 py-2 mb-6 text-sm font-medium text-brown-700 bg-brown-50 dark:bg-brown-900 dark:text-brown-300 rounded-lg border border-brown-200 dark:border-brown-700">
      Especialistas desde 2015
    </div>

    <h1 class="text-4xl font-bold text-neutral-800 dark:text-neutral-100 sm:text-5xl lg:text-6xl leading-tight mb-6">
      <Fragment set:html={title} />
    </h1>

    <div class="text-lg text-neutral-700 dark:text-neutral-300 lg:w-4/5 leading-relaxed mb-8" set:html={subTitle}></div>

    <!-- Beneficios principales de manera elegante -->
    <div class="mb-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-neutral-700 dark:text-neutral-300">
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 bg-brown-600 rounded-full"></div>
        <span class="font-medium">Garantía de 10 años</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 bg-brown-600 rounded-full"></div>
        <span class="font-medium">Instalación incluida</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 bg-brown-600 rounded-full"></div>
        <span class="font-medium">Financiamiento disponible</span>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-2 h-2 bg-brown-600 rounded-full"></div>
        <span class="font-medium">Asesoría personalizada</span>
      </div>
    </div>

    <!-- Botones CTA profesionales -->
    <div class="flex flex-col sm:flex-row gap-4 mb-8">
      {primaryBtn && (
        <PrimaryCTA
          title={primaryBtn}
          url={primaryBtnURL}
          customClasses="w-full sm:w-auto text-center rounded-lg bg-brown-600 dark:bg-brown-500 hover:bg-brown-700 dark:hover:bg-brown-600 text-white font-semibold px-8 py-3 text-base transition-all duration-300 shadow-lg hover:shadow-xl"
        />
      )}
      
      {secondaryBtn && (
        <SecondaryCTA
          title={secondaryBtn}
          url={secondaryBtnURL}
          customClasses="w-full sm:w-auto text-center rounded-lg border-2 border-brown-600 dark:border-brown-400 text-brown-700 dark:text-brown-300 hover:bg-brown-600 hover:text-white dark:hover:bg-brown-500 dark:hover:text-white font-medium px-8 py-3 text-base transition-all duration-300"
        />
      )}
    </div>

    <!-- Sección de reseñas limpia -->
    {withReview && (
      <div class="p-4 bg-neutral-50 dark:bg-neutral-800 rounded-lg border border-neutral-200 dark:border-neutral-700">
        <ReviewComponent avatars={avatars} starCount={starCount} rating={rating} reviews={reviews} />
      </div>
    )}
  </div>

  <!-- Sección de imagen con tamaño fijo y más grande -->
  <div class="flex justify-center md:justify-end">
    <div class="relative">
      <!-- Contenedor fijo para todas las imágenes -->
      <div class="w-[400px] md:w-[600px] lg:w-[700px] h-[300px] md:h-[450px] lg:h-[490px] overflow-hidden rounded-lg shadow-2xl border border-neutral-200 dark:border-neutral-700">
        <img
          id="heroImage"
          src="/images/fo-ro1.jpeg"
          alt={alt || "Imagen del producto"}
          class="w-full h-full object-cover transition-opacity duration-500 ease-in-out"
          draggable="false"
          loading="eager"
        />
      </div>
      
      <!-- Indicadores discretos -->
      <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2">
        <div class="w-3 h-3 bg-white/80 rounded-full shadow-md transition-all duration-300" id="indicator1"></div>
        <div class="w-3 h-3 bg-white/40 rounded-full shadow-md transition-all duration-300" id="indicator2"></div>
        <div class="w-3 h-3 bg-white/40 rounded-full shadow-md transition-all duration-300" id="indicator3"></div>
      </div>
    </div>
  </div>
</section>

<!-- Script simple y efectivo -->
<script>
  const images = [
    "/images/fo-ro1.jpeg",
    "/images/fo-ro2.jpeg",
    "/images/fo-ro3.jpeg"
  ];
  const indicators = ["indicator1", "indicator2", "indicator3"];
  let currentIndex = 0;

  function changeImage() {
    const heroImage = document.getElementById("heroImage") as HTMLImageElement;
    
    if (heroImage) {
      // Cambiar imagen
      heroImage.src = images[currentIndex];
      
      // Actualizar indicadores
      indicators.forEach((id, index) => {
        const indicator = document.getElementById(id);
        if (indicator) {
          indicator.style.backgroundColor = index === currentIndex ? "rgba(255,255,255,0.9)" : "rgba(255,255,255,0.4)";
        }
      });
      
      currentIndex = (currentIndex + 1) % images.length;
    }
  }

  // Cambiar imagen cada 3 segundos
  setInterval(changeImage, 3000);
</script>