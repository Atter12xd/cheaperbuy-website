---
// CompanyShowcaseSection.astro
---

<!-- Sección de Presentación de Empresa -->
<section class="relative mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 2xl:max-w-full bg-gradient-to-b from-primary-50 to-white dark:from-primary-900/20 dark:to-primary-900/5">
  
  <!-- Título de la Sección -->
  <div class="text-center mb-12">
    <div class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-wood-700 bg-wood-50 dark:bg-wood-900 dark:text-wood-300 rounded-lg border border-wood-200 dark:border-wood-700">
      {Astro.currentLocale === "en" ? "Inside. Out." : "Por Dentro. Por Fuera."}
    </div>
    <h2 class="text-3xl font-bold text-primary-800 dark:text-primary-100 sm:text-4xl lg:text-5xl mb-6">
      {Astro.currentLocale === "en" 
        ? "Manufacturing Excellence" 
        : "Excelencia en Manufactura"}
    </h2>
    <p class="text-xl text-primary-600 dark:text-primary-300 max-w-3xl mx-auto leading-relaxed">
      {Astro.currentLocale === "en"
        ? "From our manufacturing facilities to your space. We create custom-made doors and panoramic metal doors with the highest quality standards."
        : "Desde nuestras instalaciones de manufactura hasta tu espacio. Creamos puertas a medida y puertas metálicas panorámicas con los más altos estándares de calidad."
      }
    </p>
  </div>

  <!-- Imagen Principal de Presentación -->
  <div class="relative">
    <!-- Contenedor de la imagen con efecto de profundidad -->
    <div class="relative bg-gradient-to-br from-primary-800 to-primary-900 rounded-3xl overflow-hidden shadow-2xl border border-primary-700">
      <div class="aspect-[16/10] w-full relative">
        <img
          src="/images/DISEÑO.jpg"
          alt="Archipier Builder Supply - Manufacturing Process"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        
        <!-- Overlay con información destacada -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent">
          
          <!-- Badge superior izquierdo -->
          <div class="absolute top-6 left-6">
            <span class="px-4 py-2 bg-wood-600/90 backdrop-blur-sm text-white text-sm font-semibold rounded-full border border-wood-400/30">
              {Astro.currentLocale === "en" ? "Custom Manufacturing" : "Manufactura Personalizada"}
            </span>
          </div>

          <!-- Información en la parte inferior -->
          <div class="absolute bottom-0 left-0 right-0 p-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              
              <!-- Característica 1 -->
              <div class="backdrop-blur-sm bg-black/30 rounded-lg p-4 border border-white/10">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 bg-wood-600 rounded-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <h3 class="text-white font-bold text-lg">
                    {Astro.currentLocale === "en" ? "Premium Quality" : "Calidad Premium"}
                  </h3>
                </div>
                <p class="text-white/90 text-sm">
                  {Astro.currentLocale === "en" 
                    ? "Every door is crafted with precision and attention to detail" 
                    : "Cada puerta es elaborada con precisión y atención al detalle"}
                </p>
              </div>

              <!-- Característica 2 -->
              <div class="backdrop-blur-sm bg-black/30 rounded-lg p-4 border border-white/10">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 bg-wood-600 rounded-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                  </div>
                  <h3 class="text-white font-bold text-lg">
                    {Astro.currentLocale === "en" ? "Custom Design" : "Diseño Personalizado"}
                  </h3>
                </div>
                <p class="text-white/90 text-sm">
                  {Astro.currentLocale === "en" 
                    ? "Tailored solutions for your specific architectural needs" 
                    : "Soluciones adaptadas a tus necesidades arquitectónicas específicas"}
                </p>
              </div>

              <!-- Característica 3 -->
              <div class="backdrop-blur-sm bg-black/30 rounded-lg p-4 border border-white/10">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 bg-wood-600 rounded-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <h3 class="text-white font-bold text-lg">
                    {Astro.currentLocale === "en" ? "Fast Delivery" : "Entrega Rápida"}
                  </h3>
                </div>
                <p class="text-white/90 text-sm">
                  {Astro.currentLocale === "en" 
                    ? "Efficient manufacturing process ensuring timely delivery" 
                    : "Proceso de manufactura eficiente garantizando entrega oportuna"}
                </p>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Elementos decorativos -->
    <div class="absolute -top-4 -left-4 w-24 h-24 bg-wood-600/20 rounded-full blur-xl"></div>
    <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-primary-600/20 rounded-full blur-xl"></div>
  </div>

  <!-- Sección de Estadísticas -->
  <div class="mt-16 grid grid-cols-1 md:grid-cols-4 gap-8">
    
    <!-- Estadística 1 -->
    <div class="text-center p-6 bg-white dark:bg-primary-800 rounded-xl shadow-md border border-primary-200 dark:border-primary-700 hover:shadow-lg transition-shadow duration-300">
      <div class="text-3xl font-bold text-wood-600 dark:text-wood-400 mb-2">
        2015
      </div>
      <p class="text-primary-600 dark:text-primary-300 font-medium">
        {Astro.currentLocale === "en" ? "Years of Experience" : "Años de Experiencia"}
      </p>
    </div>

    <!-- Estadística 2 -->
    <div class="text-center p-6 bg-white dark:bg-primary-800 rounded-xl shadow-md border border-primary-200 dark:border-primary-700 hover:shadow-lg transition-shadow duration-300">
      <div class="text-3xl font-bold text-wood-600 dark:text-wood-400 mb-2">
        12,800+
      </div>
      <p class="text-primary-600 dark:text-primary-300 font-medium">
        {Astro.currentLocale === "en" ? "Satisfied Clients" : "Clientes Satisfechos"}
      </p>
    </div>

    <!-- Estadística 3 -->
    <div class="text-center p-6 bg-white dark:bg-primary-800 rounded-xl shadow-md border border-primary-200 dark:border-primary-700 hover:shadow-lg transition-shadow duration-300">
      <div class="text-3xl font-bold text-wood-600 dark:text-wood-400 mb-2">
        4
      </div>
      <p class="text-primary-600 dark:text-primary-300 font-medium">
        {Astro.currentLocale === "en" ? "Countries Served" : "Países Atendidos"}
      </p>
    </div>

    <!-- Estadística 4 -->
    <div class="text-center p-6 bg-white dark:bg-primary-800 rounded-xl shadow-md border border-primary-200 dark:border-primary-700 hover:shadow-lg transition-shadow duration-300">
      <div class="text-3xl font-bold text-wood-600 dark:text-wood-400 mb-2">
        10
      </div>
      <p class="text-primary-600 dark:text-primary-300 font-medium">
        {Astro.currentLocale === "en" ? "Years Warranty" : "Años de Garantía"}
      </p>
    </div>

  </div>

  <!-- Call to Action -->
  <div class="mt-16 text-center">
    <div class="inline-flex flex-col sm:flex-row gap-4">
      <a
        href="/projects"
        class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-white bg-gradient-to-r from-wood-600 to-wood-700 rounded-lg hover:from-wood-700 hover:to-wood-800 transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
        {Astro.currentLocale === "en" ? "View Our Projects" : "Ver Nuestros Proyectos"}
      </a>
      
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-wood-700 dark:text-wood-300 bg-transparent border-2 border-wood-600 dark:border-wood-400 rounded-lg hover:bg-wood-50 dark:hover:bg-wood-900 transition-all duration-300"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        {Astro.currentLocale === "en" ? "Get Quote" : "Solicitar Cotización"}
      </a>
    </div>
  </div>

</section>