---
import Meta from "@components/Meta.astro";
import Navbar from "@components/sections/navbar&footer/Navbar.astro";
import FooterSection from "@components/sections/navbar&footer/FooterSection.astro";
import CartNotification from '@components/cart/CartNotification';
import FloatingCartButton from '@components/cart/FloatingCartButton';
import { SITE } from "@data/constants";



const { title = SITE.title, meta, structuredData, lang = "es" } = Astro.props;

interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
}
---

<html lang={lang} class="lenis lenis-smooth scroll-pt-24">
  <head>
    <Meta meta={meta} structuredData={structuredData} />
    <title>{title}</title>
    <script is:inline>
  if (
    localStorage.getItem("hs_theme") === "dark" ||
    (!("hs_theme" in localStorage) &&
      window.matchMedia("(prefers-color-scheme: dark)").matches)
  ) {
    document.documentElement.classList.add("dark");
  } else {
    document.documentElement.classList.remove("dark");
  }
</script>
    <script>
      import "@scripts/lenisSmoothScroll.js";
    </script>
    <style>
      /* Scrollbar personalizada */
      ::-webkit-scrollbar {
        width: 12px;
      }
      ::-webkit-scrollbar-track {
        background: #1a1a1a;
        border-radius: 10px;
      }
      ::-webkit-scrollbar-thumb {
        background: #ff6600;
        border-radius: 10px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #cc5500;
      }
      
      /* Scroll siempre visible en móviles */
      @media (max-width: 768px) {
        html, body {
          overflow-y: auto !important;
          -webkit-overflow-scrolling: touch;
          min-height: 100vh;
        }
        ::-webkit-scrollbar {
          width: 14px;
        }
        ::-webkit-scrollbar-thumb {
          background: #ff6600;
          border-radius: 12px;
        }
      }
    </style>
  </head>

  <body class="relative text-primary-800 dark:text-primary-100 overflow-y-auto min-h-screen">
    <Navbar />

    <main class="relative min-h-screen bg-primary-50 dark:bg-primary-900 pt-24">
      <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 bg-wood-50 dark:bg-primary-800 shadow-lg rounded-lg p-6">
        <slot />
      </div>
    </main>

    <FooterSection />

    <!-- Componentes del Carrito -->
    <CartNotification client:load />
    <FloatingCartButton client:load />
  </body>
</html> 
